{
  "$defs": {
    "BodyInput": {
      "properties": {
        "source": {
          "default": "measured",
          "enum": [
            "measured",
            "preset"
          ],
          "title": "Source",
          "type": "string"
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/BodyPreset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height_cm": {
          "exclusiveMaximum": 230,
          "exclusiveMinimum": 100,
          "title": "Height Cm",
          "type": "number"
        },
        "chest_cm": {
          "anyOf": [
            {
              "exclusiveMaximum": 200,
              "exclusiveMinimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chest Cm"
        },
        "waist_cm": {
          "anyOf": [
            {
              "exclusiveMaximum": 200,
              "exclusiveMinimum": 40,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waist Cm"
        },
        "hip_cm": {
          "anyOf": [
            {
              "exclusiveMaximum": 200,
              "exclusiveMinimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hip Cm"
        },
        "pose": {
          "default": "standing",
          "enum": [
            "standing",
            "seated"
          ],
          "title": "Pose",
          "type": "string"
        }
      },
      "required": [
        "height_cm"
      ],
      "title": "BodyInput",
      "type": "object"
    },
    "BodyPreset": {
      "description": "For users who prefer not to share measurements: silhouette + usual size.",
      "properties": {
        "shape": {
          "enum": [
            "hourglass",
            "triangle",
            "inverted_triangle",
            "rectangle",
            "oval"
          ],
          "title": "Shape",
          "type": "string"
        },
        "usual_size": {
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL",
            "2XL",
            "3XL"
          ],
          "title": "Usual Size",
          "type": "string"
        },
        "sex": {
          "default": "female",
          "enum": [
            "female",
            "male"
          ],
          "title": "Sex",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "usual_size"
      ],
      "title": "BodyPreset",
      "type": "object"
    },
    "GarmentInput": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "string"
        },
        "spec_cm": {
          "$ref": "#/$defs/GarmentSpec"
        },
        "spec_source": {
          "title": "Spec Source",
          "type": "string"
        },
        "mesh_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Ref"
        },
        "fabric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fabric"
        },
        "stretch_cm": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "title": "Stretch Cm",
          "type": "object"
        }
      },
      "required": [
        "id",
        "category",
        "size",
        "spec_cm",
        "spec_source"
      ],
      "title": "GarmentInput",
      "type": "object"
    },
    "GarmentSpec": {
      "properties": {
        "chest": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chest"
        },
        "waist": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waist"
        },
        "hip": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hip"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        }
      },
      "title": "GarmentSpec",
      "type": "object"
    },
    "Preferences": {
      "properties": {
        "closure": {
          "anyOf": [
            {
              "enum": [
                "front_open",
                "pullover"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closure"
        },
        "fit_pref": {
          "anyOf": [
            {
              "enum": [
                "snug",
                "regular",
                "relaxed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Pref"
        }
      },
      "title": "Preferences",
      "type": "object"
    }
  },
  "properties": {
    "contract_version": {
      "default": "0.4.0",
      "title": "Contract Version",
      "type": "string"
    },
    "body": {
      "$ref": "#/$defs/BodyInput"
    },
    "garment": {
      "$ref": "#/$defs/GarmentInput"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences",
      "default": {
        "closure": null,
        "fit_pref": null
      }
    }
  },
  "required": [
    "body",
    "garment"
  ],
  "title": "FitRequest",
  "type": "object"
}
